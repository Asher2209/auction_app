SECRET_KEY=change-me
# development (default) or production. Production refuses to start with an unsafe configuration:
# it needs a random 32+ character SECRET_KEY, SECURE_COOKIES=1, ALLOW_TEST_EMAILS=0 and an https APP_BASE_URL
APP_ENV=development
# Set to 1 when the site is served over HTTPS (the session cookie is then only sent over HTTPS)
SECURE_COOKIES=0
# Background loop that starts and closes auctions (leave on)
ENABLE_SCHEDULER=1
# SQLite by default. For MySQL: mysql+pymysql://user:pass@localhost/auction_db
DATABASE_URL=sqlite:///auction.db
# Set to 0 in production so reserved domains like .test are rejected
ALLOW_TEST_EMAILS=1
# Email (leave MAIL_SERVER empty in development: emails are printed to the server log)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=ChainBid <noreply@example.com>
# Public address of the site, used for links inside emails
APP_BASE_URL=http://127.0.0.1:5000
# Cryptocurrency payments on a TEST network (see docs/CRYPTO_SETUP.md). Leave RPC_URL empty to disable.
# RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# CONTRACT_ADDRESS=0x...
# Card token contract (CollectibleCardToken). Deploy with:  python scripts/deploy_contract.py token
# COLLECTIBLE_CONTRACT_ADDRESS=
# 1 = a card can only be listed once its token is minted and the chain confirms the owner (fails closed)
# LISTING_REQUIRES_MINTED_TOKEN=0
# CHAIN_ID=11155111
# CHAIN_NAME=Sepolia
# BLOCK_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# CONFIRMATIONS_REQUIRED=2
# INR_PER_ETH=320000
# Development only: in-process test chain with a demo wallet, no MetaMask needed
# LOCAL_CHAIN=1
