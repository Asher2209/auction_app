SECRET_KEY=change-me
# development (default) or production. Production refuses to start with an unsafe configuration:
# it needs a random 32+ character SECRET_KEY, SECURE_COOKIES=1, ALLOW_TEST_EMAILS=0 and an https APP_BASE_URL
APP_ENV=development
# Set to 1 when the site is served over HTTPS (the session cookie is then only sent over HTTPS)
SECURE_COOKIES=0
# Background jobs (start and close auctions...) inside the web process. Set 0 on web servers when a separate
# `flask run-worker` process runs them (docs/DEPLOYMENT.md)
ENABLE_SCHEDULER=1
# Redis: needed with more than one process (shared live updates and rate limits). Empty: everything in this process.
# REDIS_URL=redis://localhost:6379/0
# Proxies in front of the app: 1 behind one load balancer. 0 trusts no X-Forwarded-* header.
# TRUSTED_PROXY_HOPS=0
# Uploaded images: local (disk) or s3 (an S3-compatible bucket such as Cloudflare R2)
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://images.example.com
# Error reports (optional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# Tests only: run the suite on a database server instead of in-memory SQLite, e.g.
# TEST_DATABASE_URL=postgresql+psycopg://mintlot:mintlot@localhost:5432/mintlot_test
# SQLite by default (development). Production: postgresql+psycopg://user:pass@host:5432/mintlot
DATABASE_URL=sqlite:///auction.db
# Set to 0 in production so reserved domains like .test are rejected
ALLOW_TEST_EMAILS=1
# Email (leave MAIL_SERVER empty in development: emails are printed to the server log)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=MintLot <noreply@example.com>
# Public address of the site, used for links inside emails
APP_BASE_URL=http://127.0.0.1:5000
# "Sign in with Google" (off unless both are set). In Google Cloud Console > APIs & Services > Credentials, create an
# OAuth client ID of type "Web application" and add this redirect URI: <APP_BASE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Cryptocurrency payments on a TEST network (see docs/CRYPTO_SETUP.md). Leave RPC_URL empty to disable.
# RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# CONTRACT_ADDRESS=0x...
# Card token contract (CollectibleCardToken). Deploy with:  python scripts/deploy_contract.py token
# COLLECTIBLE_CONTRACT_ADDRESS=
# 1 = a card can only be listed once its token is minted and the chain confirms the owner (fails closed)
# LISTING_REQUIRES_MINTED_TOKEN=0
# CHAIN_ID=11155111
# CHAIN_NAME=Sepolia
# BLOCK_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# CONFIRMATIONS_REQUIRED=2
# INR_PER_ETH=320000
# Contact address shown on the Privacy, Terms, Refund and Cookie pages
LEGAL_CONTACT_EMAIL=privacy@mintlot.local
# Display time zone (fixed offset, no daylight saving). Times are stored as UTC and typed/shown in this zone.
APP_TZ_NAME=IST
APP_TZ_OFFSET_MINUTES=330
# Development only: in-process test chain with a demo wallet, no MetaMask needed
# LOCAL_CHAIN=1
