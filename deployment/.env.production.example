# Production Environment Configuration

# Flask
FLASK_ENV=production
FLASK_APP=app:create_app
SECRET_KEY=<generate-with-secrets.token_hex(32)>
DEBUG=False

# Security
SECURE_COOKIES=1
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Strict
ALLOWED_HOSTS=chainbid.example,www.chainbid.example

# Database
DATABASE_URL=sqlite:///instance/auction.db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# Blockchain (Sepolia)
APP_ENV=production
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
CONTRACT_ADDRESS=0xC3240cFD2c9ec199Be2715F27816a1f538629307
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
BLOCK_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
CONFIRMATIONS_REQUIRED=2
INR_PER_ETH=320000

# RPC Failover (Optional)
FALLBACK_RPC_URL=https://sepolia.infura.io/v3/<YOUR_INFURA_KEY>
RPC_TIMEOUT=30
RPC_MAX_RETRIES=3

# Email (for alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=<your-email>
MAIL_PASSWORD=<your-app-password>
MAIL_DEFAULT_SENDER=ChainBid<noreply@chainbid.example>

# Alerts
ALERT_EMAIL=admin@chainbid.example
SLACK_WEBHOOK=<optional-slack-webhook>

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Backup
DATABASE_BACKUP_ENABLED=1
DATABASE_BACKUP_TIME=02:00
DATABASE_BACKUP_RETENTION_DAYS=30

# HTTPS
HTTPS_ONLY=1
HSTS_ENABLED=1
HSTS_MAX_AGE=31536000

# Performance
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
MAX_CONTENT_LENGTH=16777216

# Rate Limiting
RATELIMIT_ENABLED=1
RATELIMIT_AUTH=1000/hour
RATELIMIT_UNAUTH=100/hour
