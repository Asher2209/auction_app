# Production settings for MintLot (see docs/DEPLOYMENT.md). Copy into your platform's secret store, never into git.
APP_ENV=production
SECRET_KEY=
SECURE_COOKIES=1
APP_BASE_URL=https://mintlot.example
ALLOW_TEST_EMAILS=0
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql+psycopg://mintlot:PASSWORD@db-host:5432/mintlot
REDIS_URL=rediss://default:PASSWORD@redis-host:6379
# 0 on web containers when a separate worker runs `flask run-worker`
ENABLE_SCHEDULER=0

STORAGE_BACKEND=s3
S3_BUCKET=mintlot-images
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://images.mintlot.example

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=MintLot <noreply@mintlot.example>

# optional
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# blockchain (test network only)
RPC_URL=
CONTRACT_ADDRESS=
COLLECTIBLE_CONTRACT_ADDRESS=
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
LEGAL_CONTACT_EMAIL=privacy@mintlot.example
